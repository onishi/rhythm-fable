  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260629.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "wrangler": "^4.105.0"
  }
}
